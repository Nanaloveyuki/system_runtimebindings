license = "Apache-2.0"

readme = "README.md"

keywords = [ "moonbit", "android", "runtime", "logging" ]

preferred_target = "native"

source = "src"

import {
  "Nanaloveyuki/BitLogger@0.12.0",
  "Nanaloveyuki/ajni@0.4.0",
}
